# Copy to .env and fill in. .env is gitignored; .env.example is not.

# Port this backend listens on. The Vite dev server proxies /api here.
PORT=7010

# The nb-wallet-side wallet_connect server.
#   local devenv : http://localhost:9070
#   deployed     : https://nbwallet.org/wc
# The /wc prefix is where nginx fronts wallet_connect — /api/ on that host is
# already attestation_storage.
WALLET_CONNECT_URL=https://nbwallet.org/wc

# Must match the `apiKey` on the `zzp_garantie` entry in wallet_connect's
# clients.json. Never commit the real value.
WALLET_CONNECT_API_KEY=
